#!/bin/bash

groupmod -o -g "${PGID}" rssfeedtoolbox
usermod -o -u "${PUID}" rssfeedtoolbox

chown -R rssfeedtoolbox:rssfeedtoolbox \
    "${HOME}" \
    /app \
    /frontend \
    /config \
    /var/lib/nginx \
    /var/log/nginx
chown rssfeedtoolbox:rssfeedtoolbox /etc/hosts /tmp

nginx

umask "${UMASK}"

alembic upgrade head && exec gosu rssfeedtoolbox:rssfeedtoolbox python3 /app/main.py